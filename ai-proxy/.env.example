# MiniMax API key (pay-as-you-go). Get from https://platform.minimax.io → API Keys.
ANTHROPIC_API_KEY=sk-...

# MiniMax Anthropic-compatible endpoint. Override only if you self-host.
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic

# Default model. Options: MiniMax-M3.1-Flash-Preview, MiniMax-M3, MiniMax-M2.7,
# MiniMax-M2.7-highspeed, MiniMax-M2.5, MiniMax-M2.5-highspeed, MiniMax-M2.1,
# MiniMax-M2.1-highspeed, MiniMax-M2.
PROXY_DEFAULT_MODEL=MiniMax-M3

# Local server port.
PORT=8787

# Comma-separated list of origins allowed to call the proxy.
# Default covers unpacked extensions (chrome-extension://) and localhost dev.
PROXY_ALLOWED_ORIGINS=chrome-extension://*,http://localhost:*